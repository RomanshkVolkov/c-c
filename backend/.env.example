PORT=8080

# Opción 1 — URL completa (recomendada para producción/Docker)
DATABASE_URL=postgres://postgres:password@localhost:5432/cac?sslmode=disable

# Opción 2 — Variables individuales (se usan si DATABASE_URL no está definida)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=cac
DB_SSLMODE=disable

JWT_SECRET_ACCESS=change-me-access-secret-min-32-chars
JWT_SECRET_REFRESH=change-me-refresh-secret-min-32-chars

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234

# APP_ENV — shown in the startup banner (development | staging | production)
APP_ENV=development

# image-service (reports screenshots UPLOAD) — same wiring as portento/marvi.
# API key is printed once by `project-admin create-s3` (see infra/terraform/reports-media).
IMAGE_SERVICE_URL=https://image-service.dwitmexico.com
IMAGE_SERVICE_CERT_CN=cac-reports
IMAGE_SERVICE_API_KEY=

# reports-media S3 (screenshot READS via the authenticated backend proxy — no
# CDN). The IAM user's keys from infra/terraform/reports-media. If left empty the
# backend falls back to the default AWS credential chain.
REPORTS_MEDIA_BUCKET=guz-reports-media
REPORTS_MEDIA_REGION=mx-central-1
REPORTS_MEDIA_ACCESS_KEY_ID=
REPORTS_MEDIA_SECRET_ACCESS_KEY=

# Secret for signing short-lived image proxy URLs (defaults to JWT_SECRET_ACCESS).
IMAGE_URL_SECRET=
# HMAC secret for hashing ingest keys.
INGEST_KEY_SECRET=change-me-ingest-hmac-secret
