#!/bin/sh
# {{ ansible_managed }}
# Respaldo de Postgres de hah: pg_dumpall (roles y todas las bases) a disco,
# comprimido, y se borra lo más viejo que {{ postgres_backup_retention_days }}
# días. Lo lanza el cron del usuario de operación y también se puede correr a
# mano. Se restaura con
#   gunzip -c <fichero> | docker exec -i <contenedor> psql -U postgres
set -eu
umask 077

dir='{{ pg_backup_dir }}'
ctr=$(docker ps -q -f name={{ postgres_stack }}_postgres | head -n1)
if [ -z "$ctr" ]; then
  echo "{{ postgres_stack }}: no hay contenedor de postgres corriendo" >&2
  exit 1
fi

mkdir -p "$dir"
out="$dir/{{ postgres_stack }}-$(date -u +%Y%m%d-%H%M).sql.gz"
tmp="$out.part"
trap 'rm -f "$tmp"' EXIT

docker exec "$ctr" pg_dumpall -U postgres --clean --if-exists | gzip -9 > "$tmp"
# Un volcado vacío es un fallo, no un respaldo.
if [ "$(stat -c %s "$tmp")" -lt 1024 ]; then
  echo "{{ postgres_stack }}: el volcado salió vacío" >&2
  exit 1
fi
mv "$tmp" "$out"
trap - EXIT

find "$dir" -name '{{ postgres_stack }}-*.sql.gz' -mtime +{{ postgres_backup_retention_days }} -delete
echo "$out"
