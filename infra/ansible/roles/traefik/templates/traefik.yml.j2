# {{ ansible_managed }}
# Traefik para {{ base_domain }}: wildcard por reto DNS. Lo escribe Ansible
# (roles/traefik); no se edita aquí.
services:
  traefik:
    image: {{ traefik_image }}
    networks: [{{ traefik_network }}]
    ports:
      - {target: 80, published: 80, protocol: tcp, mode: host}
      - {target: 443, published: 443, protocol: tcp, mode: host}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - traefik_acme:/letsencrypt:rw
    secrets: [dns_api_token]
    environment:
      # lego lee el token del fichero: no queda en la definición del stack.
      CF_DNS_API_TOKEN_FILE: /run/secrets/dns_api_token
    command:
      - --entrypoints.web.address=:80
      - --entrypoints.websecure.address=:443
      - --entrypoints.web.http.redirections.entrypoint.to=websecure
      - --entrypoints.web.http.redirections.entrypoint.scheme=https
      - --providers.swarm=true
      - --providers.swarm.endpoint=unix:///var/run/docker.sock
      - --providers.swarm.exposedbydefault=false
      - --providers.swarm.network={{ traefik_network }}
      - --log.level=INFO
      - --accesslog=true
      - --certificatesresolvers.wildcard.acme.email={{ acme_email }}
      - --certificatesresolvers.wildcard.acme.storage=/letsencrypt/acme.json
      - --certificatesresolvers.wildcard.acme.dnschallenge=true
      - --certificatesresolvers.wildcard.acme.dnschallenge.provider={{ acme_dns_provider }}
      # Contra resolvers públicos: el del host no ve el TXT recién creado.
      - --certificatesresolvers.wildcard.acme.dnschallenge.resolvers=1.1.1.1:53,8.8.8.8:53
      - --certificatesresolvers.wildcard.acme.dnschallenge.propagation.delayBeforeChecks=30s
      # Sin --api.insecure: el dashboard no se publica.
    deploy:
      mode: replicated
      replicas: 1
      placement:
        constraints: [node.role==manager]
      restart_policy: {condition: on-failure, delay: 5s, max_attempts: 3}
      labels: ["traefik.enable=false"]

networks:
  {{ traefik_network }}:
    external: true

# Dentro del contenedor el fichero se llama dns_api_token; fuera, el secret
# lleva su versión. Rotar es crear otro y redesplegar.
secrets:
  dns_api_token:
    external: true
    name: {{ dns_token_secret }}

volumes:
  traefik_acme:
