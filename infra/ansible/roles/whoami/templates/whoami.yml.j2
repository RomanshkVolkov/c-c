# {{ ansible_managed }}
services:
  whoami:
    image: {{ whoami_image }}
    networks: [{{ traefik_network }}]
    deploy:
      replicas: 1
      labels:
        - traefik.enable=true
        - traefik.http.routers.whoami.rule=Host(`whoami.{{ base_domain }}`)
        - traefik.http.routers.whoami.entrypoints=websecure
        - traefik.http.routers.whoami.tls.certresolver=wildcard
        # Un solo certificado para todo el servidor: el apex y el wildcard.
        - traefik.http.routers.whoami.tls.domains[0].main={{ base_domain }}
        - traefik.http.routers.whoami.tls.domains[0].sans=*.{{ base_domain }}
        - traefik.http.services.whoami.loadbalancer.server.port=80

networks:
  {{ traefik_network }}:
    external: true
